{
  "name": "pizzaria-observavel",
  "version": "2.0.0",
  "private": true,
  "description": "Aplicação de exemplo (3 microsserviços) instrumentada com métricas, logs e traces para a aula de Observabilidade — Engenharia de Software II",
  "scripts": {
    "build": "tsc",
    "pedidos": "node --require ./dist/tracing.js dist/pedidos.js",
    "pagamentos": "node --require ./dist/tracing.js dist/pagamentos.js",
    "cozinha": "node --require ./dist/tracing.js dist/cozinha.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "express": "^4.22.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
