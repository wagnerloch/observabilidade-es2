{
  "uid": "pizzaria-visao-geral",
  "title": "Pizzaria: Visão Geral",
  "description": "Dashboard de exemplo da aula de Observabilidade — métricas (Prometheus), logs (Loki) e traces (Tempo).",
  "tags": [
    "aula",
    "observabilidade",
    "pizzaria"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Explore",
      "type": "link",
      "url": "/explore",
      "icon": "compass",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "servico",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total{job=\"pizzaria\"}, service)",
          "refId": "servico"
        },
        "definition": "label_values(http_requests_total{job=\"pizzaria\"}, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Modo caos alterado",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{app=\"pizzaria\"} |= \"modo caos alterado\" | json",
        "titleFormat": "Caos: {{service_name}}",
        "textFormat": "modo = {{modo}}",
        "instant": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🍕 Negócio — o que o dono da pizzaria quer saber",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pedidos confirmados / min",
      "description": "Vazão de pedidos concluídos com sucesso (métrica de negócio: pizzaria_pedidos_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pizzaria_pedidos_total{resultado=\"confirmado\"}[1m])) * 60",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 60
              },
              {
                "color": "green",
                "value": 120
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Faturamento (período)",
      "description": "Soma do valor dos pedidos confirmados no intervalo de tempo selecionado no topo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pizzaria_faturamento_reais_total[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Pedidos com sucesso",
      "description": "Confirmados ÷ (todos os pedidos válidos). Pedidos com sabor inválido não entram na conta.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pizzaria_pedidos_total{resultado=\"confirmado\"}[2m])) / sum(rate(pizzaria_pedidos_total{resultado!=\"invalido\"}[2m])) * 100",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 85
              },
              {
                "color": "green",
                "value": 93
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Pedidos em andamento",
      "description": "Gauge: quantos pedidos estão sendo processados AGORA. Sobe quando algum serviço fica lento.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pizzaria_pedidos_em_andamento)",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
