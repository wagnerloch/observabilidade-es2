{
  "name": "observabilidade-demo",
  "version": "1.0.0",
  "description": "Projeto de demonstração de observabilidade com Node.js, Prometheus e Grafana",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
