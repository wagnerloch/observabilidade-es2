    "load:stress": "node scripts/load-stress.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "prom-client": "^15.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
